# Copy to `.env` and edit. Every value below is the default, so an empty file
# behaves identically to no file at all.
#
# Run `ledger doctor` after editing to check the result before booting anything.

# ---------------------------------------------------------------- the model
#
# The one setting most people want. Without a key, Ledger answers from a
# scripted model and says so in the UI -- the tool calls, governance events and
# query results are all still real, only the narration is canned.
#
# Get one at https://platform.claude.com/ -> Settings -> API keys.
# New accounts get a small one-time credit, which is more than enough here:
# a question costs a fraction of a cent.
ANTHROPIC_API_KEY=

# fake | anthropic | auto  (auto = anthropic when a key is set, else fake)
LEDGER_MODEL=auto
LEDGER_ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
LEDGER_ANTHROPIC_EFFORT=medium
LEDGER_MAX_TURNS=8
# Milliseconds between token chunks from the scripted model. 0 is instant;
# 12 or so makes a demo look like real streaming.
LEDGER_FAKE_TOKEN_DELAY_MS=0

# ---------------------------------------------------------------- the data
LEDGER_DATA_DIR=./data
LEDGER_MONTHS=2024-12,2025-01,2025-02
# auto | rebuild | offline. `offline` loads the committed catalogue and never
# profiles or calls an LLM -- what CI, Docker, and the E2E suite use.
LEDGER_CATALOG_MODE=auto
LEDGER_DUCKDB_THREADS=4
LEDGER_DUCKDB_MEMORY_LIMIT=2GB

# ---------------------------------------------------------------- database
# Accounts and conversations. Separate from the analytical store by design:
# that one is read-only, in-memory, and shared between processes.
#   docker compose up -d postgres   ->  localhost:5455
LEDGER_DATABASE_URL=postgresql+asyncpg://ledger:ledger@localhost:5455/ledger
LEDGER_DATABASE_ECHO=false
# Convenient locally; production runs `alembic upgrade head` deliberately,
# because a schema change should not happen as a side effect of a restart.
LEDGER_DATABASE_AUTO_MIGRATE=true

# ---------------------------------------------------------------- auth
# dev   -- password-reset responses carry the token inline, so a reset can be
#          completed without a mail server.
# strict-- the token is logged only, and reaching it requires the mail path.
LEDGER_AUTH_MODE=dev
# Addresses granted the analyst role at signup: a full address, or a domain
# written with a leading @. Comma-separated. Without it, the first account on
# an empty database becomes the analyst and everyone after is a viewer.
LEDGER_ANALYST_EMAILS=
# At least 32 bytes (RFC 7518). `strict` refuses to start on the built-in one.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
LEDGER_JWT_SECRET=
LEDGER_JWT_TTL_SECONDS=43200

# ---------------------------------------------------------------- governance
# Kafka is a hard dependency: every tool call is recorded *before* its result
# is served, so the API will not start without a broker.
#   docker compose up -d kafka   ->  localhost:29092
LEDGER_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
LEDGER_KAFKA_BOOTSTRAP_TIMEOUT_S=30
LEDGER_KAFKA_TOPIC_TOOL_CALLS=ledger.tool-calls
LEDGER_KAFKA_TOPIC_ACCESS_DENIED=ledger.access-denied
LEDGER_KAFKA_CONSUMER_GROUP=ledger-audit

# ---------------------------------------------------------------- mcp
# A stdio client has no auth layer, so this defaults to the restrictive role.
LEDGER_MCP_ROLE=viewer
LEDGER_MCP_TENANT=

# ---------------------------------------------------------------- limits
LEDGER_MODEL_MAX_ROWS=200
LEDGER_CACHE_MAX_ROWS=2000
LEDGER_MAX_GROUP_CARDINALITY=1000
